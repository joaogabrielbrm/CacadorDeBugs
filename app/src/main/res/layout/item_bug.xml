<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/bug_surface"
    android:padding="14dp">

    <ImageView
        android:id="@+id/ivBug"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/descricao_bug"
        android:src="@drawable/ic_bug"
        android:scaleType="centerInside"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCodigoBug"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/bug_primary"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivBug"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvTituloBug"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/bug_text"
        android:textSize="17sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/tvCodigoBug"
        app:layout_constraintStart_toEndOf="@id/ivBug"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvModuloBug"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/bug_text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvTituloBug"
        app:layout_constraintStart_toEndOf="@id/ivBug"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvGravidadeBug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBug"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvStatusBug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivBug"
        app:layout_constraintStart_toEndOf="@id/tvGravidadeBug" />

    <TextView
        android:id="@+id/tvDescricaoBug"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:textColor="@color/bug_text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvGravidadeBug"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>